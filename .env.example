# 本文件为配置样例：复制为 .env 后填入真实值。
# 切勿把填充后的 .env 提交到代码库（其中含数据库口令、JWT 密钥、支付密钥）。
#
# 变量与 docker-compose.yml / application.yml 一一对应：
# 标注 [必填] 的变量缺失时应用会启动失败（占位符形如 ${DB_USER:?DB_USER must be set}）。
#
# ⚠️ 读这个文件前先知道一件事（2026-11-03 实测）：
#    本文件写的是**生产应该用的配置**，与老服务器 8.147.60.8 上 systemd 单元里的**实际值不一致**。
#    判断"线上能不能跑"必须查 `systemctl cat wuye-points.service` + `/proc/<MainPID>/environ`，
#    不能拿本文件或 application-prod.yml 的默认值当线上结论。
#
# 线上实际值与本文件的差异（截至 2026-11-03 22:20）：
#   1. `WECHAT_PAY_MCH_ID` 线上是 **1665249236**（平台自营直连号），占错了服务商槽位；
#      服务商 1752012787 的整套凭据（私钥/序列号/公钥）没有上服务器。
#   2. 线上 `WECHAT_PAY_API_V3_KEY` 长度 **40**（公司名+统一社会信用代码拼的自造串），
#      微信强制 32 位 → 回调解密与平台证书拉取失败，进件接口因此返回 99016。
#   3. 线上**没有** `WECHAT_PAY_PUBLIC_KEY_ID/_PATH` → 不进公钥模式；1752012787 是新商户，
#      只有微信支付公钥、没有平台证书，按证书模式必然失败。
#   4. 线上**完全没有** `WECHAT_DIRECT_*` → 直连通道未就绪，平台自营在线支付与
#      （分账关闭时的）商城订单全部 fail-closed。
#   5. 线上无 `APP_AUTH_TEST_MODE`（即默认 true，弱口令放行）、无 `CORS_ORIGINS`（即 `*`）。
#   6. 分账四个开关线上全 false；`payment_records` 最后一笔成功现金支付是 2026-10-16，
#      且 `pay_mode` 全为 NULL（双通道改造之前的老代码路径）。

# ===== 运行环境 =====
# Spring profile：生产必须为 prod（dev 会跳过微信鉴权，绝不可用于生产）
SPRING_PROFILES_ACTIVE=prod
# 容器内上传目录与证书目录，需与 docker-compose 的卷挂载保持一致
UPLOAD_PATH=/data/uploads

# ===== 数据库 [必填] =====
DB_HOST=mysql
DB_PORT=3306
DB_NAME=wuye_points
DB_USER=root
DB_PASSWORD=

# ===== 鉴权 [必填] =====
# 生产务必使用随机长密钥（>=32 字节），泄露即可伪造任意角色令牌
JWT_SECRET=

# ===== 微信小程序 [必填] =====
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
# 微信接口跳过开关：生产必须为 false；本地开发由 application-dev.yml 开启，测试服可显式设 true
# ⚠️ true 时任何人可用 dev_ 前缀伪造微信身份，仅限测试服
APP_WECHAT_SKIP_API=false
# 测试模式：放开初始口令 admin123456，并允许普通住户登录管理端
# ⚠️ 上线前必须改为 false，否则弱口令与住户管理端登录均保持放开
APP_AUTH_TEST_MODE=true

# 欠费催缴订阅消息模板（留空则跳过微信推送，回退为应用内消息）
WECHAT_ARREARS_TEMPLATE_ID=
WECHAT_ARREARS_PAGE_PATH=

# ===== 微信支付：服务商通道（sp_mchid）=====
# 用于商城订单收款 + 微信官方服务商分账。与下方「直连商户通道」是两套独立商户主体，凭据不可混用。
# 主体：盘锦华帝网络科技有限公司（合作伙伴类型=开发者），服务商号 1752012787。
WECHAT_PAY_ENABLED=true
WECHAT_PAY_MCH_ID=1752012787
# APIv3 密钥：**32 位**，值在项目根「微信合作伙伴平台信息/」目录（该目录已整目录 ignore，不入库）。
# 老服务器当前填的是 40 位自造串，会导致解密/验签失败与进件 99016，必须替换。
WECHAT_PAY_API_V3_KEY=
# 私钥二选一：PRIVATE_KEY_BASE64（推荐，无文件依赖）或 PRIVATE_KEY_PATH（需与卷挂载一致）
# 来源：微信合作伙伴平台信息/1752012787_20261027_cert.zip 内的 apiclient_key.pem
WECHAT_PAY_PRIVATE_KEY_BASE64=
WECHAT_PAY_PRIVATE_KEY_PATH=/opt/wxcert/1752012787/apiclient_key.pem
WECHAT_PAY_MERCHANT_SERIAL_NUMBER=3BDE4E98996D960A27D13EFCBD5368159D122C4F
WECHAT_PAY_APP_ID=wxf7230afd38275659
# 服务商支付/退款回调（须 HTTPS，域名需公网可达）
WECHAT_PAY_NOTIFY_URL=https://test.yuanxusoftware.top/api/v1/payment/notify/wechatpay
WECHAT_PAY_REFUND_NOTIFY_URL=https://test.yuanxusoftware.top/api/v1/payment/notify/wechatpay
# 微信支付公钥（2024 年后新开商户默认验签方式，替代平台证书）
# ⚠️ 1752012787 是新商户，**只有公钥、没有平台证书**：这两项不配就会按证书模式去拉 /v3/certificates 并失败。
# 公钥 ID 与 pub_key.pem 来源见 微信合作伙伴平台信息/（值不入库，公钥 ID 本身不是密钥）
WECHAT_PAY_PUBLIC_KEY_ID=PUB_KEY_ID_0117520127872026102700192123001602
WECHAT_PAY_PUBLIC_KEY_PATH=/opt/wxcert/1752012787/pub_key.pem
WECHAT_PAY_PUBLIC_KEY_BASE64=
WECHAT_PAY_PLATFORM_SUB_MCH_ID=
WECHAT_PAY_SUB_MCH_IDS=
# 分账标识：服务商通道下单时强制 settle_info.profit_sharing=true（本项仅兼容保留）
WECHAT_PAY_PROFIT_SHARING=false
# 微信分账业务总开关（fail-closed；商城订单在开关开启后才走服务商通道）
# ⚠️ 开启前两个硬前提（2026-11-02/03 实测）：
#   ① `wechat_split_receiver_accounts` 必须先在管理端配齐接收方（物业=商户号、其余角色=个人 openid）。
#      空表时一开分账，除平台佣金外**所有接收方静默落 skipped**，钱留在商家冻结池、30 天窗口到期解冻回商家，
#      平台和各负责人一分拿不到；账户补齐后由每日 03:20 的补分调度自动追回。
#   ② 每个特约商户要在其商户平台「产品中心→授权的产品→分账授权」确认并设最大分账比例（默认 30%），
#      且服务商 JSAPI 支付/API 退款是另外两个独立授权产品，只开分账会缺权限。
WECHAT_SPLIT_ENABLED=false
# 售后窗口天数（微信服务商分账最长冻结 30 天，超过按 30 处理）
WECHAT_SPLIT_AFTER_SALE_DAYS=7
# 单笔订单分账总额上限比例，须与微信商户平台「最大分账比例」一致
WECHAT_SPLIT_MAX_RATIO=0.30
# 是否允许用户主动发起订单退款（fail-closed 默认 false）
WECHAT_SPLIT_USER_REFUND_ENABLED=false
# 归集户余额监控告警阈值（元），留空=不监控
WECHAT_SPLIT_COLLECT_ALERT_THRESHOLD=
# 自动提现开关（fail-closed，默认 false）。
# 生效范围：仅「电商收付通」模式有真实资金动作；「普通分账」模式下收款方自行在微信商户平台提现，
# 开启仅推进本地状态位，不代表平台自动打款。
WECHAT_SPLIT_AUTO_WITHDRAW_ENABLED=false
# 模拟支付开关：生产必须为 false（true 会让任何人零成本获得保证金/食堂额度）
APP_PAYMENT_MOCK_ENABLED=false
# 广告微信支付开关（默认开启；前端需支持 pending_payment/active/cancelled 与“去支付”）
MERCHANT_AD_WECHAT_PAYMENT_ENABLED=true
WECHAT_PAY_ACCOUNT_TYPE=BASIC
WECHAT_PAY_WITHDRAW_NOTIFY_URL=
# 合作方接收方关系类型（平台自身固定 SERVICE_PROVIDER，不由此项控制）
# 官方枚举：SERVICE_PROVIDER / STORE / STAFF / STORE_OWNER / PARTNER / HEADQUARTER / BRAND /
# DISTRIBUTOR / USER / SUPPLIER / CUSTOM；PARTNER=合作伙伴，适合物业/协调员/快递员等合作方
WECHAT_PAY_RECEIVER_RELATION_TYPE=PARTNER
# 仅当关系类型为 CUSTOM 时必填（微信要求 1-10 字），其余取值不得填写
WECHAT_PAY_RECEIVER_CUSTOM_RELATION=
# 平台作为分账接收方的商户全称（服务商主体全称，MERCHANT_ID 接收方 name 必填）
WECHAT_PAY_PLATFORM_RECEIVER_NAME=盘锦华帝网络科技有限公司
# 微信 API 超时（毫秒）
WECHAT_PAY_CONNECT_TIMEOUT_MS=5000
WECHAT_PAY_READ_TIMEOUT_MS=20000
# 快递员分成核算口径：true=走配送费（B 方案），false=四档分成含快递（A 方案）
WUYE_DIST_COURIER_DELIVERY=true

# ===== 微信支付：直连商户通道（平台自营业务）=====
# 用于物业费/物业币充值/食堂/广告/服务预约/活动组/保证金等平台自收业务，资金进本商户号，不做分账。
# 与上面 WECHAT_PAY_*（服务商）是不同商户主体：APIv3 密钥、API 证书、回调地址均不可互换。
# 商户号 1665249236（2026-05-24 那套 API 证书）。
# ⚠️ 老服务器当前**完全没有这一组变量**，因此平台自营在线支付全部被拒（WECHAT_DIRECT_NOT_CONFIGURED，
#    无回退逻辑）；分账开关关闭时商城订单也落到这条通道，同样被拒。配齐下面 5 项后把 ENABLED 置 true。
# ⚠️ 1665 的 APIv3 密钥需去该商户平台重设一个真实 32 位值——线上现在填在服务商槽里的那个 40 位串不能用。
WECHAT_DIRECT_ENABLED=false
WECHAT_DIRECT_MCH_ID=1665249236
WECHAT_DIRECT_API_V3_KEY=
WECHAT_DIRECT_PRIVATE_KEY_BASE64=
WECHAT_DIRECT_PRIVATE_KEY_PATH=/opt/binddate/cert/apiclient_key.pem
WECHAT_DIRECT_MERCHANT_SERIAL_NUMBER=7824E2C7DE9B1BD8070146F2EFA1432A3DBA4070
WECHAT_DIRECT_APP_ID=wxf7230afd38275659
# 直连支付/退款回调（与服务商回调路径不同，不可复用）
WECHAT_DIRECT_NOTIFY_URL=https://test.yuanxusoftware.top/api/v1/payment/notify/wechatpay-direct
WECHAT_DIRECT_REFUND_NOTIFY_URL=https://test.yuanxusoftware.top/api/v1/payment/notify/wechatpay-direct
# 老商户走平台证书模式；确认其是否也发放了微信支付公钥后再填
WECHAT_DIRECT_PUBLIC_KEY_ID=
WECHAT_DIRECT_PUBLIC_KEY_PATH=
WECHAT_DIRECT_PUBLIC_KEY_BASE64=

# ===== 商家进件（服务商「特约商户进件」） =====
# 商家在小程序/后台自助填资料，后端提交 POST /v3/applyment4sub/applyment/，凭据复用上面的 WECHAT_PAY_*。
WECHAT_APPLYMENT_ENABLED=true
# 资料保存后是否自动提交微信（默认 false，由商家点「提交」或运营触发）
WECHAT_APPLYMENT_AUTO_SUBMIT=false
# 入驻结算规则ID 与 所属行业（可留空，使用官方公示表默认值）
# 留空时：企业主体自动 716、个体户自动 719（费率 0.6%，T+1）；行业默认「居民生活服务」
# 官方公示表：https://kf.qq.com/faq/220228IJb2UV220228uEjU3Q.html
WECHAT_APPLYMENT_SETTLEMENT_ID=
WECHAT_APPLYMENT_QUALIFICATION_TYPE=
WECHAT_APPLYMENT_FINANCE_INSTITUTION=false

# ===== 电商收付通（**本方案已废弃，不要启用**）=====
# 2026-10-21 定版：走「服务商 + 特约商户」普通分账（/v3/profitsharing/*），不走电商收付通
# （/v3/ecommerce/*）。原因：两段式"平台归集再分"=二清，且收付通要求平台自身先成为二级商户。
# 以下变量仅为兼容代码保留，**任何情况都保持 false / 留空**；置 true 会让下单与提现走错资金路径。
# 连带影响：置 false 时「绑定收款账号」页（/transfer-accounts → merchant_transfer_accounts）无消费方，
# 提现由收款方自行在微信商户平台完成。
WECHAT_ECOMMERCE_ENABLED=false
WECHAT_ECOMMERCE_PLATFORM_RECEIVER_MCH_ID=
WECHAT_ECOMMERCE_PLATFORM_SUB_MCH_ID=
WECHAT_ECOMMERCE_RECEIVER_RELATION_TYPE=SERVICE_PROVIDER
WECHAT_ECOMMERCE_TRANSFER_CHANNEL=zero
# 以下两个回调地址须为公网 HTTPS，且须与 application.yml 默认值保持一致；
# 注意：此处留空会被空串覆盖（而非回退 yml 默认），改域名请填完整地址。
WECHAT_ECOMMERCE_NOTIFY_URL=https://test.yuanxusoftware.top/api/v1/payment/ecommerce-split/notify
WECHAT_ECOMMERCE_TRANSFER_NOTIFY_URL=https://test.yuanxusoftware.top/api/v1/payment/ecommerce-transfer/notify

# ===== 安全与跨域 =====
# 生产环境请改为具体域名，切勿使用 *
CORS_ORIGINS=*
# 反向代理已终止 TLS 时开启 HSTS
HSTS_ENABLED=false

# ===== 限流 =====
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_MS=300000

# ===== 数据库迁移 =====
# Flyway 默认关闭（application.yml 用 ${FLYWAY_ENABLED:false}）；存量库首次接入会被标记为 V1 基线，不会重复建表。
# 注意：prod profile 内已硬编码 enabled=false（生产恒不启用），故本变量仅对非 prod profile（dev/测试）生效。
FLYWAY_ENABLED=false

# ===== 外部可达地址 =====
UPLOAD_BASE_URL=

# ===== 雪花 ID 机器号（多实例部署时必须各不相同，否则会产生重复 ID） =====
MACHINE_ID=1
