<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置。要点：
  1. 所有日志自动携带 traceId（%X{traceId}），由 TraceIdFilter 写入；
  2. 控制台与文件均使用同一 pattern，本地与容器排查体验一致；
  3. 文件按天滚动 + 总量上限，避免容器磁盘被日志打满；
  4. 使用异步 Appender，避免日志 IO 阻塞业务线程（支付/分账链路对 RT 敏感）。
-->
<configuration>

    <springProperty scope="context" name="LOG_PATH" source="logging.file.path" defaultValue="logs"/>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="wuye-points"/>

    <property name="CONSOLE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] traceId=%X{traceId:-} %logger{36} - %msg%n"/>
    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] traceId=%X{traceId:-} %logger{50} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 异步包装：队列满时丢弃 TRACE/DEBUG/INFO，保证 ERROR 不丢 -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE"/>
        <queueSize>8192</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_FILE"/>
    </root>

    <!-- 业务包：INFO。支付/分账链路的告警由代码内 log.warn 输出。 -->
    <logger name="com.wuye.points" level="INFO"/>

    <!-- Hibernate SQL 默认不打印；参数绑定（BasicBinder）默认关闭，
         因其会明文输出手机号、身份证等参数，仅在排障时通过环境变量临时开启。 -->
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="WARN"/>
    <logger name="org.hibernate.orm.jdbc.bind" level="WARN"/>

    <logger name="org.springframework.web.client.RestTemplate" level="WARN"/>
    <logger name="net.javacrumbs.shedlock" level="WARN"/>
</configuration>
